{
  "name": "pi-dev-team",
  "version": "0.6.0",
  "description": "A team of AI agents for pi: spec, plan, build with tests, review, pull request. Works with every pi provider.",
  "license": "MIT",
  "author": "Sanjit Roopra (https://github.com/sanjit-roopra)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjit-roopra/pi-dev-team.git"
  },
  "homepage": "https://github.com/sanjit-roopra/pi-dev-team#readme",
  "bugs": {
    "url": "https://github.com/sanjit-roopra/pi-dev-team/issues"
  },
  "keywords": [
    "pi-package",
    "agents",
    "code-review",
    "tdd",
    "dev-team"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/spend/index.ts",
      "./extensions/dev-team/index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.ts && python3 -m unittest discover -s test/py -p 'test_*.py'",
    "e2e": "node test/e2e/run.mjs",
    "version": "python3 devtools/changelog.py && git add CHANGELOG.md",
    "index": "python3 hooks/lib/build_knowledge_index.py"
  },
  "files": [
    "extensions",
    "agents",
    "skills",
    "hooks",
    "scripts",
    "knowledge",
    "templates",
    "tools",
    "bin",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!skills/**/node_modules/**"
  ]
}
