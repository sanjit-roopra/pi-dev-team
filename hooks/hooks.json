            "command": "sh \"${DEV_TEAM_ROOT}/hooks/py.sh\" \"${DEV_TEAM_ROOT}/hooks/codegraph_bootstrap.py\""
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
